.reference/
.idea/
.vscode/
.gitignore

# Locally-created pi sessions (from running the `pi` binary against this repo)
.pi/

# Release/publish run logs (stdouts captured during `task publish` etc.)
*-publish.log
task-*.log
release-*.log
.claude/*
target/*

# Benchmark scratch: the npm-installed native pi that scripts/bench-vs-pi.mjs
# compares against (~400 MiB of node_modules).
.bench/

# Static frontend deployment bundle
.deploy/
.codegraph
# Runtime state of any ki project (`.ki/goals.json`, sessions, ...). `.ki/*` only
# covered this checkout as the worktree root, so a test running with the cwd set
# to `crates/kiqi-cli` could still write into the tree; `**/.ki/*` covers every
# depth. It sits before the skill negations on purpose: a pattern placed later
# would match `.ki/skills` itself and silently kill the `!` re-includes below.
# Note that this also ignores a *nested* `.ki/skills/**` (the negations only
# re-include the root one), so a fixture that needs nested skill files has to
# get its own `!` rule here.
.ki/*
**/.ki/*
!.ki/skills/
.ki/skills/*
!.ki/skills/kiqi-extension-authoring/
!.ki/skills/kiqi-extension-authoring/SKILL.md
!.ki/skills/kiqi-release/
!.ki/skills/kiqi-release/SKILL.md
website/.ki/*
.git/kiqi-release-helper.exe
publish-*.log

# Guest-side workspace (wasm32-wasip2) build output. No trailing slash: the
# path is sometimes a CARGO_TARGET_DIR symlink, which a directory-only pattern
# does not match and would leak into `git add -A`.
plugins/wasm/target
